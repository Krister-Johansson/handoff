{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@handoff/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-with-github",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "GITHUB_TOKEN=$(gh auth token --user Krister-Johansson) exec pnpm --filter @handoff/web dev"
      ],
      "port": 3000
    }
  ]
}
