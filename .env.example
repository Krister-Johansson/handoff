DATABASE_URL=postgres://handoff:handoff@localhost:5433/handoff
TEST_DATABASE_URL=postgres://handoff:handoff@localhost:5433/handoff_test
HANDOFF_HOME=./.handoff
HANDOFF_CLAUDE_BIN=claude
HANDOFF_CLAUDE_VERSION=2.1.285
HANDOFF_ALLOW_CLI_DRIFT=
HANDOFF_CAP_CLI=1
HANDOFF_CAP_SHELL=4
HANDOFF_CAP_GITHUB=4
HANDOFF_CAP_FUNCTION=8
HANDOFF_WORKER_ID=
# worktree runs claude on the host; docker runs each run in a container (build it with pnpm docker:runner)
HANDOFF_WORKSPACE=worktree
HANDOFF_DOCKER_IMAGE=handoff-runner:2.1.285
HANDOFF_DOCKER_NETWORK=
# From `claude setup-token`. Never use ANTHROPIC_API_KEY here.
CLAUDE_CODE_OAUTH_TOKEN=
MCP_TIMEOUT=30000
# OAuth tokens for MCP servers signed in from the dashboard. Defaults to ~/.handoff/mcp-oauth; the dashboard and the worker must agree.
HANDOFF_OAUTH_DIR=
# GitHub: either a token (for example `gh auth token`) or a GitHub App.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./.handoff/github-app.pem
# Any random string; pnpm dev:webhooks signs forwarded events with it (openssl rand -hex 32).
GITHUB_WEBHOOK_SECRET=
WEB_PORT=3000
WEB_URL=http://localhost:3000
HANDOFF_MAX_TURNS=60
HANDOFF_MODEL=
# The dashboard's assistant runs the Claude Code CLI with CLAUDE_CODE_OAUTH_TOKEN; without the token it is off.
HANDOFF_ASSISTANT_MODEL=sonnet
HANDOFF_ASSISTANT_EFFORT=low
HANDOFF_ASSISTANT_MAX_TURNS=12
HANDOFF_ASSISTANT_APPROVAL_TIMEOUT_MS=300000

# Voice: the dashboard speaks with ElevenLabs. Without a key nothing is read aloud.
ELEVENLABS_API_KEY=
# Optional: the default voice id (else the account's first voice) and the model.
HANDOFF_ELEVENLABS_VOICE_ID=
HANDOFF_ELEVENLABS_MODEL=eleven_flash_v2_5
