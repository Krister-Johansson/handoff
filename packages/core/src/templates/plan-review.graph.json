        "y": 0
      }
    },
    {
      "key": "coder",
      "attributes": {
        "type": "coder",
        "label": "Code",
        "config": {
          "maxTurns": "auto"
        },
        "x": 900,
        "y": 0
      }
    },
    {
      "key": "tester",
      "attributes": {
        "type": "tester",
        "label": "Test",
        "config": {
          "command": "npm test --if-present"
        },
        "x": 1200,
        "y": 0
      }
    },
    {
      "key": "ask",
      "attributes": {
        "type": "human_gate",
        "label": "Answer the coder",
        "config": {
          "mode": "question"
        },
        "x": 1200,
        "y": 200
      }
    },
    {
      "key": "demo",
      "attributes": {
        "type": "demo",
        "label": "Demo",
        "x": 1500,
        "y": 0,
        "config": {
