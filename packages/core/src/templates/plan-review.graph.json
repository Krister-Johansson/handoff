        "label": "Plan",
        "config": {},
        "x": 0,
        "y": 0
      }
    },
    {
      "key": "plan-review",
      "attributes": {
        "type": "reviewer",
        "label": "Review the plan",
        "config": {
          "instructions": "Check that the plan covers the task and every linked issue, that the steps are in a workable order and small enough to test, and that it names the files it will change. Write a comment per problem, using path \"plan\"; a gap a coder could not get past without guessing is blocking."
        },
        "x": 300,
        "y": 0
      }
    },
    {
      "key": "approval",
      "attributes": {
        "type": "human_gate",
        "label": "Approve the plan",
        "config": {},
