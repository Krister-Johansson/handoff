{
  "attributes": {
    "name": "loop",
    "startNode": "planner",
    "exhaustedGate": "gate"
  },
  "options": {
    "type": "directed",
    "multi": false,
    "allowSelfLoops": false
  },
  "nodes": [
    {
      "key": "planner",
      "attributes": {
        "type": "planner",
        "label": "Plan",
        "x": 0,
        "y": 0
      }
    },
    {
      "key": "coder",
      "attributes": {
        "type": "coder",
        "label": "Code",
        "x": 340,
        "y": 0,
        "contextSelector": {
          "includeFeedback": true
        },
        "config": {
          "maxTurns": "auto"
        }
      }
    },
    {
      "key": "tester",
      "attributes": {
        "type": "tester",
        "label": "Test",
        "x": 680,
        "y": 0,
        "config": {
          "command": "npm test --if-present"
        }
      }
    },
    {
      "key": "reviewer",
      "attributes": {
        "type": "reviewer",
        "label": "Review",
        "x": 1020,
        "y": 0
      }
    },
    {
      "key": "demo",
      "attributes": {
        "type": "demo",
        "label": "Demo",
        "x": 1360,
        "y": 0,
        "config": {
          "when": "ui_changes"
        }
      }
    },
    {
      "key": "try",
      "attributes": {
        "type": "human_gate",
        "label": "Try it",
        "x": 1700,
        "y": 0,
        "config": {
          "mode": "try"
        }
      }
    },
    {
      "key": "pr",
      "attributes": {
        "type": "pr",
        "label": "Pull request",
        "x": 2040,
        "y": 0
      }
    },
    {
      "key": "merge",
      "attributes": {
        "type": "merge",
        "label": "Merge",
        "x": 2380,
        "y": 0
      }
    },
    {
      "key": "gate",
      "attributes": {
        "type": "human_gate",
        "label": "Ask a person",
        "x": 340,
        "y": -130
      }
    }
  ],
  "edges": [
    {
      "key": "planner->coder",
      "source": "planner",
      "target": "coder",
      "attributes": {
        "loop": false
      }
    },
    {
      "key": "coder->tester",
      "source": "coder",
      "target": "tester",
      "attributes": {
        "loop": false,
        "condition": {
          "eq": [
            "node.output.status",
            "done"
          ]
        }
      }
    },
    {
      "key": "coder->gate",
      "source": "coder",
      "target": "gate",
      "attributes": {
        "loop": false,
        "condition": {
          "eq": [
            "node.output.status",
            "needs_input"
          ]
        }
      }
    },
    {
      "key": "gate->coder",
      "source": "gate",
      "target": "coder",
      "attributes": {
        "loop": true,
        "maxAttempts": 5,
        "condition": {
          "neq": [
            "node.output.option",
            "abort"
          ]
        }
      }
    },
    {
      "key": "tester->reviewer",
      "source": "tester",
      "target": "reviewer",
      "attributes": {
        "loop": false,
        "condition": {
          "eq": [
            "node.output.passed",
            true
          ]
        }
      }
    },
    {
      "key": "tester->coder",
      "source": "tester",
      "target": "coder",
      "attributes": {
        "loop": true,
        "maxAttempts": 3,
        "condition": {
          "eq": [
            "node.output.passed",
            false
          ]
        }
      }
    },
    {
      "key": "reviewer->demo",
      "source": "reviewer",
      "target": "demo",
      "attributes": {
        "port": "approve"
      }
    },
    {
      "key": "demo->try",
      "source": "demo",
      "target": "try",
      "attributes": {
        "port": "done"
      }
    },
    {
      "key": "demo->pr",
      "source": "demo",
      "target": "pr",
      "attributes": {
        "port": "skipped"
      }
    },
    {
      "key": "try->pr",
      "source": "try",
      "target": "pr",
      "attributes": {
        "port": "approve"
      }
    },
    {
      "key": "try->coder",
      "source": "try",
      "target": "coder",
      "attributes": {
        "port": "changes"
      }
    },
    {
      "key": "reviewer->coder",
      "source": "reviewer",
      "target": "coder",
      "attributes": {
        "loop": true,
        "maxAttempts": 3,
        "condition": {
          "eq": [
            "node.output.verdict",
            "request_changes"
          ]
        }
      }
    },
    {
      "key": "pr->merge",
      "source": "pr",
      "target": "merge",
      "attributes": {
        "loop": false,
        "condition": {
          "all": [
            {
              "eq": [
                "node.output.feedback.ci.status",
                "success"
              ]
            },
            {
              "neq": [
                "node.output.feedback.review.decision",
                "changes_requested"
              ]
            }
          ]
        }
      }
    },
    {
      "key": "pr->coder",
      "source": "pr",
      "target": "coder",
      "attributes": {
        "loop": true,
        "maxAttempts": 3,
        "condition": {
          "any": [
            {
              "eq": [
                "node.output.feedback.ci.status",
                "failure"
              ]
            },
            {
              "eq": [
                "node.output.feedback.review.decision",
                "changes_requested"
              ]
            }
          ]
        }
      }
    },
    {
      "key": "merge->pr",
      "source": "merge",
      "target": "pr",
      "attributes": {
        "port": "update",
        "loop": true,
        "maxAttempts": 3
      }
    }
  ]
}
